rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin do painel: reconhecido pelo UID da conta (Authentication › Users), não pelo e-mail.
    // O cadastro fica aberto para o portal do aluno; com ele aberto, qualquer um poderia criar uma
    // conta com um e-mail de admin que ainda não existe. Mantenha igual aos uid de USERS em js/nuvem/config.js.
    function permitido() {
      return request.auth != null
        && request.auth.uid in [
          'Uhr6XYnS5jcaLEB05MaJFW11Msu1'
        ];
    }

    function dataISO(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    // A regra não consegue olhar cada número da lista; o app confere (128 números entre -1 e 1).
    function descritor(v) { return v is list && v.size() == 128; }

    // ---------- Painel (etapa 2): todos os dados das telas ----------
    // Um documento por tipo (alunos, mensalidades...) com itens: { id: item }; check-ins, um por mês.
    // Cada campo é conferido no app (js/logica/baldes.js); aqui, quem pode e o formato do documento.
    match /painel/{doc} {
      allow read, delete: if permitido();
      allow create, update: if permitido() && nomeOk(doc) && (
        (doc == 'meta' && request.resource.data.keys().hasOnly(['versao', 'geradoEm', 'semeadoEm']))
        || (doc == 'config' && request.resource.data.keys().hasOnly(['valor']) && request.resource.data.valor is map)
        || (doc != 'meta' && doc != 'config' && request.resource.data.keys().hasOnly(['itens']) && request.resource.data.itens is map));
    }
    function nomeOk(doc) {
      return doc.matches('^(meta|config|checkins-[0-9]{4}-[0-9]{2}|[a-zA-Z]{2,30})$');
    }

    // ---------- Coleções da etapa 1: só leitura (copiadas para o painel no 1º acesso) ----------
    match /alunos/{id} { allow read: if permitido(); }
    match /turmas/{id} { allow read: if permitido(); }
    match /checkins/{id} { allow read: if permitido(); }

    // ---------- Rosto: só números (descritores), miniatura pequena e consentimento ----------
    // O id do documento é o do aluno ou o do professor (a foto da aula reconhece os dois).
    match /rostos/{pessoaId} {
      allow read, delete: if permitido();
      allow create, update: if permitido() && rostoOk(request.resource.data)
        && (pessoaId in get(/databases/$(database)/documents/painel/alunos).data.itens
          || pessoaId in get(/databases/$(database)/documents/painel/professores).data.itens);
    }
    function rostoOk(d) {
      return d.keys().hasOnly(['d0', 'd1', 'd2', 'mini', 'consentimento', 'atualizadoEm'])
        && descritor(d.d0)
        && (!('d1' in d) || descritor(d.d1))
        && (!('d2' in d) || descritor(d.d2))
        && (!('mini' in d) || (d.mini is string && d.mini.size() < 20000 && d.mini.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && d.consentimento is map
        && d.consentimento.keys().hasOnly(['por', 'responsavel', 'data'])
        && d.consentimento.por is string && d.consentimento.por.size() >= 2 && d.consentimento.por.size() <= 80
        && d.consentimento.responsavel is bool
        && dataISO(d.consentimento.data)
        && d.atualizadoEm == request.time;
    }

    // ---------- Foto da aula: uma por aula (id = turma_dia), JPEG pequeno ----------
    // O app só guarda se todas as crianças marcadas na foto tiverem autorização de imagem.
    match /fotos/{fotoId} {
      allow read: if permitido() || (aluno() && (resource == null || resource.data.turmaId in get(/databases/$(database)/documents/portalGrade/atual).data.turmas));
      allow delete: if permitido();
      allow create, update: if permitido() && fotoOk(request.resource.data)
        && fotoId == request.resource.data.turmaId + '_' + request.resource.data.data
        && request.resource.data.turmaId in get(/databases/$(database)/documents/painel/turmas).data.itens;
    }
    function fotoOk(d) {
      return d.keys().hasOnly(['turmaId', 'data', 'foto', 'legenda', 'professorId', 'atualizadoEm'])
        && d.turmaId is string && dataISO(d.data)
        && d.foto is string && d.foto.size() < 360000 && d.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && d.legenda is string && d.legenda.size() <= 140
        && (!('professorId' in d) || d.professorId is string)
        && d.atualizadoEm == request.time;
    }

    // ---------- Portal do aluno (/aluno) ----------
    // O painel libera o e-mail em acessos/{email} e mantém um espelho só com o que cada aluno pode ver.
    // Quem cria conta sem ter sido liberado (ou sem confirmar o e-mail) não lê nada.
    function aluno() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/acessos/$(request.auth.token.email))
        && get(/databases/$(database)/documents/acessos/$(request.auth.token.email)).data.ativo == true;
    }
    function meuAlunoId() { return get(/databases/$(database)/documents/acessos/$(request.auth.token.email)).data.alunoId; }

    match /acessos/{email} {
      allow read: if permitido() || (request.auth != null && request.auth.token.email == email && request.auth.token.email_verified == true);
      allow write: if permitido();
    }
    match /portal/{alunoId} {
      allow read: if permitido() || (aluno() && alunoId == meuAlunoId());
      allow write: if permitido();
    }
    match /portalGrade/{id} {
      allow read: if permitido() || aluno();
      allow write: if permitido();
    }
    // Diário de cada aluno: só ele lê e escreve (nem o painel lê).
    match /diarios/{alunoId}/aulas/{aulaId} {
      allow read, delete: if aluno() && alunoId == meuAlunoId();
      allow create, update: if aluno() && alunoId == meuAlunoId() && diarioOk(request.resource.data)
        && request.resource.data.turmaId in get(/databases/$(database)/documents/portalGrade/atual).data.turmas
        && aulaId == request.resource.data.turmaId + '_' + request.resource.data.data;
    }
    // Check-in pelo celular: o aluno cria o dele (um por turma e dia); o painel junta na presença e apaga.
    match /checkinsAluno/{id} {
      allow read: if permitido() || (aluno() && resource.data.alunoId == meuAlunoId());
      allow delete: if permitido();
      allow create: if aluno() && request.resource.data.alunoId == meuAlunoId()
        && id == request.resource.data.alunoId + '_' + request.resource.data.turmaId + '_' + request.resource.data.data
        && request.resource.data.turmaId in get(/databases/$(database)/documents/portalGrade/atual).data.turmas
        && checkinOk(request.resource.data);
    }
    function textoAte(d, campo, max) { return !(campo in d) || (d[campo] is string && d[campo].size() <= max); }
    function diarioOk(d) {
      return d.keys().hasOnly(['aprendi', 'revisar', 'dificuldade', 'tecnicas', 'turmaId', 'data', 'atualizadoEm'])
        && d.turmaId is string && d.turmaId.size() <= 60 && dataISO(d.data)
        && textoAte(d, 'aprendi', 4000) && textoAte(d, 'revisar', 4000)
        && (!('dificuldade' in d) || (d.dificuldade is int && d.dificuldade >= 1 && d.dificuldade <= 5))
        && (!('tecnicas' in d) || (d.tecnicas is string && d.tecnicas.size() <= 10500))
        // Sem diário de dia futuro (a data é a do dia da aula).
        && request.time >= timestamp.date(int(d.data.split('-')[0]), int(d.data.split('-')[1]), int(d.data.split('-')[2]))
        && d.atualizadoEm == request.time;
    }
    function checkinOk(d) {
      return d.keys().hasOnly(['alunoId', 'turmaId', 'data', 'hora', 'distancia', 'criadoEm'])
        && d.turmaId is string && d.turmaId.size() <= 60 && dataISO(d.data)
        && d.hora is string && d.hora.matches('^[0-9]{2}:[0-9]{2}$')
        && d.distancia is number && d.distancia >= 0 && d.distancia <= 100
        && d.criadoEm == request.time;
    }

    // Qualquer outro caminho: negado (é o padrão do Firestore, deixado explícito).
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
